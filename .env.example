# Credenciales del bot (obligatorio).
TELEGRAM_BOT_TOKEN=

# Chats autorizados a usar el bot (subir CV, elegir nivel, recibir avisos),
# separados por coma. Cualquier otro chat que le escriba es ignorado.
# Ejemplo con dos personas (tú y tu novio):
# TELEGRAM_CHAT_IDS=111111111,222222222
TELEGRAM_CHAT_IDS=

# (Viejo, opcional) Si solo tienes un usuario puedes seguir usando esta en
# vez de TELEGRAM_CHAT_IDS — se sigue soportando por compatibilidad.
TELEGRAM_CHAT_ID=

# Palabras clave base separadas por coma (se comparan en minúsculas contra el
# título). Además de esto, el bot también avisa si el título coincide con
# alguna skill detectada en tu CV (ver sección CV en el README).
KEYWORDS=developer,desarrollador,programador,fullstack,full stack,backend,back-end,software engineer

# País para Computrabajo / Indeed: mx, co, ar, cl, pe, es
COUNTRY=mx

# Fuentes activas, separadas por coma
ENABLED_SOURCES=remoteok,weworkremotely,computrabajo,infojobs,indeed,linkedin,getonboard

# Solo avisa de ofertas publicadas dentro de las últimas N horas (si la fuente
# no expone fecha confiable, la oferta se deja pasar de todas formas)
RECENCY_HOURS=24

# Puerto del servidor (Render/Railway lo inyectan automáticamente)
PORT=3000
